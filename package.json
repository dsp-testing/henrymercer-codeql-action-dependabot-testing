    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "@chrisgavin/safe-which": "^1.0.3",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/types": "^18.0.0",
    "@schemastore/package": "1.0.5",
    "@types/uuid": "^9.0.8",
    "adm-zip": "^0.6.1",
    "check-disk-space": "^3.4.0",
    "console-log-level": "^1.4.1",
