    "@types/get-folder-size": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.6.2",
    "@types/semver": "^7.8.0",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "ava": "^8.0.1",
    "eslint": "^10.11.0",
